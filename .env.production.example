# ------------------------------------------------------------------------------
# Google Cloud Run Environment Variables for ToppScorers
# ------------------------------------------------------------------------------

# Application mode & port (Cloud Run automatically sets PORT to 8080)
NODE_ENV=production
PORT=8080

# MongoDB Atlas URI (Cloud database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/toppscorers?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_characters_here

# Frontend URL (Leave empty or set to your Cloud Run URL, e.g. https://toppscorers-xyz-uc.a.run.app)
CLIENT_URL=

# WhatsApp Contact & Support Number (optional)
WHATSAPP_NUMBER=919999999999

# Google OAuth Credentials (optional, for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
